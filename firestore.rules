rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidContactMessageCreate(data) {
      return data.keys().hasAll(['name', 'email', 'message', 'status', 'createdAt'])
        && data.keys().hasOnly(['name', 'email', 'message', 'status', 'createdAt'])
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 80
        && data.email is string && data.email.size() >= 5 && data.email.size() <= 120
        && data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$')
        && data.message is string && data.message.size() >= 10 && data.message.size() <= 1500
        && data.status is string && data.status == 'unread'
        && data.createdAt is timestamp
        && data.createdAt == request.time;
    }

    // Contact messages collection:
    // Public visitors may only create validated unread messages.
    // All client-side reads, updates, and deletes are strictly denied.
    match /messages/{messageId} {
      allow get, list, update, delete: if false;
      allow create: if isValidId(messageId) && isValidContactMessageCreate(incoming());
    }
  }
}
