rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrapAdminEmail() {
      return isVerifiedUser() && request.auth.token.email == 'jubayer0099yt@gmail.com';
    }

    function isAdmin() {
      return isVerifiedUser() && (
        isBootstrapAdminEmail() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidContactMessageCreate(data) {
      return data.keys().hasAll(['name', 'email', 'message', 'status', 'createdAt'])
        && data.keys().hasOnly(['name', 'email', 'message', 'status', 'createdAt'])
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 80
        && data.email is string && data.email.size() >= 5 && data.email.size() <= 120
        && data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$')
        && data.message is string && data.message.size() >= 10 && data.message.size() <= 1500
        && data.status is string && data.status == 'unread'
        && data.createdAt is timestamp
        && data.createdAt == request.time;
    }

    function isValidContactMessageUpdate(data) {
      return data.keys().hasAll(['name', 'email', 'message', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['name', 'email', 'message', 'status', 'createdAt', 'updatedAt'])
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 80
        && data.email is string && data.email.size() >= 5 && data.email.size() <= 120
        && data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$')
        && data.message is string && data.message.size() >= 10 && data.message.size() <= 1500
        && data.status is string && (data.status == 'unread' || data.status == 'read')
        && data.createdAt is timestamp
        && data.createdAt == existing().createdAt
        && data.name == existing().name
        && data.email == existing().email
        && data.message == existing().message
        && data.updatedAt is timestamp
        && data.updatedAt == request.time;
    }

    function isValidAdminProfile(data, adminUid) {
      return data.keys().hasAll(['uid', 'email', 'createdAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'createdAt'])
        && data.uid is string && data.uid == request.auth.uid && data.uid == adminUid
        && isValidId(data.uid)
        && data.email is string && data.email.size() >= 5 && data.email.size() <= 120
        && data.email == request.auth.token.email
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100))
        && data.createdAt is timestamp;
    }

    // Contact messages collection
    match /messages/{messageId} {
      allow get: if isAdmin() && isValidId(messageId);
      allow list: if isBootstrapAdminEmail();
      allow create: if isValidId(messageId) && isValidContactMessageCreate(incoming());
      allow update: if isAdmin()
        && isValidId(messageId)
        && isValidContactMessageUpdate(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if isAdmin() && isValidId(messageId);
    }

    // Admin UID registry collection
    match /admins/{adminUid} {
      allow get: if isVerifiedUser() && request.auth.uid == adminUid && isValidId(adminUid);
      allow list: if false;
      allow create: if isBootstrapAdminEmail()
        && isValidId(adminUid)
        && request.auth.uid == adminUid
        && isValidAdminProfile(incoming(), adminUid)
        && incoming().createdAt == request.time;
      allow update: if isBootstrapAdminEmail()
        && isValidId(adminUid)
        && request.auth.uid == adminUid
        && isValidAdminProfile(incoming(), adminUid)
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email']);
      allow delete: if false;
    }
  }
}
