{
  "entities": {
    "ContactMessage": {
      "title": "Contact Message",
      "description": "Public visitor inquiry submitted through the JUBAYER Contact Me form.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Sender full or display name",
          "minLength": 2,
          "maxLength": 80
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Sender email address",
          "minLength": 5,
          "maxLength": 120,
          "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$"
        },
        "message": {
          "type": "string",
          "description": "Inquiry message body",
          "minLength": 10,
          "maxLength": 1500
        },
        "status": {
          "type": "string",
          "description": "Inbox read state",
          "enum": ["unread", "read"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server-assigned creation timestamp"
        }
      },
      "required": ["name", "email", "message", "status", "createdAt"]
    }
  },
  "firestore": {
    "/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ContactMessage" },
      "description": "Stores visitor messages submitted from Contact Me. Publicly writable on create with strict validation; all client reads, updates, and deletes are denied."
    }
  }
}
